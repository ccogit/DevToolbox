COMMENT ON TABLE ALT_RISIKO IS 'Altdaten VHV Risiko; BESTAND oder SCHWEBE';
COMMENT ON COLUMN ALT_RISIKO.RISIKONUMMER IS 'Risiko: risikonummer (String)';
COMMENT ON COLUMN ALT_RISIKO.RISIKOART IS 'Risiko: risikoart (String)';
COMMENT ON COLUMN ALT_RISIKO.VERSICHERUNGSSUMME IS 'Risiko: versicherungssumme (BigDecimal)';

-- Fiktive, DB2-nahe Altdatenstruktur fuer die DevToolbox; keine Echtdaten.
-- ALT_VERTRAG bildet die Schluesselmenge; in allen Tabellen ist DATENSTAND Teil des Schluessels.
-- Vertrag: je Vertrag und Datenstand genau ein Satz; Bestand und Schwebe bleiben getrennt.
CREATE TABLE ALT_VERTRAG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    VERTRAGSNUMMER VARCHAR(80),
    TARIF VARCHAR(80),
    BEGINN DATE,
    ABLAUF DATE,
    ZAHLWEISE VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);
COMMENT ON TABLE ALT_VERTRAG IS 'Altdaten VHV Vertrag; BESTAND oder SCHWEBE';
COMMENT ON COLUMN ALT_VERTRAG.VERTRAGSNUMMER IS 'Vertrag: vertragsnummer (String)';
COMMENT ON COLUMN ALT_VERTRAG.TARIF IS 'Vertrag: tarif (String)';
COMMENT ON COLUMN ALT_VERTRAG.BEGINN IS 'Vertrag: beginn (LocalDate)';
COMMENT ON COLUMN ALT_VERTRAG.ABLAUF IS 'Vertrag: ablauf (LocalDate)';
COMMENT ON COLUMN ALT_VERTRAG.ZAHLWEISE IS 'Vertrag: zahlweise (String)';

-- Vorgang: je Vertrag und Datenstand genau ein Satz; Bestand und Schwebe bleiben getrennt.
CREATE TABLE ALT_VORGANG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    VORGANGSNUMMER VARCHAR(80),
    VORGANGSART VARCHAR(80),
    EINGANG DATE,
    BEARBEITUNGSSTATUS VARCHAR(80),
    PRIORITAET INTEGER,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);
COMMENT ON TABLE ALT_VORGANG IS 'Altdaten VHV Vorgang; BESTAND oder SCHWEBE';
COMMENT ON COLUMN ALT_VORGANG.VORGANGSNUMMER IS 'Vorgang: vorgangsnummer (String)';
COMMENT ON COLUMN ALT_VORGANG.VORGANGSART IS 'Vorgang: vorgangsart (String)';
COMMENT ON COLUMN ALT_VORGANG.EINGANG IS 'Vorgang: eingang (LocalDate)';
COMMENT ON COLUMN ALT_VORGANG.BEARBEITUNGSSTATUS IS 'Vorgang: bearbeitungsstatus (String)';
COMMENT ON COLUMN ALT_VORGANG.PRIORITAET IS 'Vorgang: prioritaet (Integer)';

-- Risiko: je Vertrag und Datenstand genau ein Satz; Bestand und Schwebe bleiben getrennt.

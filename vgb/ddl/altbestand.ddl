-- Synthetische, DB2-nahe VGB-Altstruktur. Daten und Modell stehen erst am Anfang.
-- Der DDL-Umfang ist als Testinput vollstaendig; Implementierung bleibt bewusst lueckenhaft.
CREATE TABLE ALT_VGBVERTRAG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    VERTRAGSNUMMER VARCHAR(80),
    TARIF VARCHAR(80),
    BEGINN DATE,
    ABLAUF DATE,
    ZAHLWEISE VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBVORGANG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    VORGANGSNUMMER VARCHAR(80),
    VORGANGSART VARCHAR(80),
    EINGANG DATE,
    BEARBEITUNGSSTATUS VARCHAR(80),
    PRIORITAET INTEGER,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBRISIKO (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    RISIKONUMMER VARCHAR(80),
    RISIKOART VARCHAR(80),
    VERSICHERUNGSSUMME DECIMAL(15,2),
    TARIFIERUNGSZONE VARCHAR(80),
    SELBSTBEHALT DECIMAL(15,2),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBNACHLASSZUSCHLAGRISIKOBEZOGEN (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    MERKMAL VARCHAR(80),
    PROZENTSATZ DECIMAL(15,2),
    BETRAG DECIMAL(15,2),
    GUELTIG_AB DATE,
    GRUND VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBNACHLASSZUSCHLAGVERTRAGSBEZOGEN (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    MERKMAL VARCHAR(80),
    PROZENTSATZ DECIMAL(15,2),
    BETRAG DECIMAL(15,2),
    GUELTIG_AB DATE,
    GRUND VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBBEITRAG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    BRUTTOBEITRAG DECIMAL(15,2),
    NETTOBEITRAG DECIMAL(15,2),
    VERSICHERUNGSTEUER DECIMAL(15,2),
    ZAHLWEISE VARCHAR(80),
    FAELLIGKEIT DATE,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBOBJEKTDATEN (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    OBJEKTART VARCHAR(80),
    WOHNFLAECHE DECIMAL(15,2),
    BAUJAHR INTEGER,
    BAUARTKLASSE VARCHAR(80),
    NUTZUNG VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBWERTERMITTLUNG (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    ERMITTLUNGSART VARCHAR(80),
    NEUWERT DECIMAL(15,2),
    INDEXJAHR INTEGER,
    INDEXFAKTOR DECIMAL(15,2),
    STAND DATE,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBVORVERSICHERER (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    GESELLSCHAFT VARCHAR(80),
    VERTRAGSNUMMER_ALT VARCHAR(80),
    SCHADENFREI_SEIT DATE,
    VORVERTRAG_ENDE DATE,
    SCHADENZAHL INTEGER,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBNEBENVERSICHERER (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    GESELLSCHAFT VARCHAR(80),
    VERTRAGSNUMMER_FREMD VARCHAR(80),
    ANTEIL_PROZENT DECIMAL(15,2),
    DECKUNGSBEREICH VARCHAR(80),
    BEGINN DATE,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBSTANDORT (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    STRASSE VARCHAR(80),
    HAUSNUMMER VARCHAR(80),
    PLZ VARCHAR(80),
    ORT VARCHAR(80),
    LAND VARCHAR(80),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBWERTSACHEN (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    KATEGORIE VARCHAR(80),
    EINZELWERT DECIMAL(15,2),
    ANZAHL INTEGER,
    AUFBEWAHRUNG VARCHAR(80),
    GRENZE DECIMAL(15,2),
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);

CREATE TABLE ALT_VGBDECKUNGEN (
    VERTRAG_ID BIGINT NOT NULL,
    DATENSTAND VARCHAR(16) NOT NULL,
    DECKUNGSART VARCHAR(80),
    SUMME DECIMAL(15,2),
    SELBSTBETEILIGUNG DECIMAL(15,2),
    EINSCHLUSS VARCHAR(80),
    GUELTIG_AB DATE,
    PRIMARY KEY (VERTRAG_ID, DATENSTAND)
);
